# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

*.db
*.db-journal
/lib/generated

# uploaded files (로컬 디스크 저장 — 새 업로드는 추적하지 않음.
# 이미 커밋된 기존 파일은 `git rm -r --cached public/uploads`로 별도 제거 필요)
/public/uploads

# internal docs (커밋하지 않는 내부 문서)
/docs/pre-launch-checklist.md